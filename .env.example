# Firebase Admin
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Optional. Defaults to <projectId>.appspot.com then <projectId>.firebasestorage.app
FIREBASE_STORAGE_BUCKET=

# JWT Authentication (required — use long random secrets; access ≠ refresh)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Shopify
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_WEBHOOK_SECRET=
NEXT_PUBLIC_SHOPIFY_SHOP_DOMAIN=
NEXT_PUBLIC_SHOPIFY_API_VERSION=

# Orders Firestore cutover (Phase 3–6)
# Webhooks + logistics cron upsert into Firestore (needed for near-realtime).
ORDERS_WRITE_TO_FIRESTORE=true
# Dashboard /api/shopify/orders reads from Firestore snapshot (disk + memory).
ORDERS_READ_FROM_FIRESTORE=true
# Background cache↔Firestore compare (dev/verify only). Keep false in prod.
ORDERS_SHADOW_COMPARE=false

# Shiprocket
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Pickup pincode used for courier rate lookup (Ship Now → rates)
SHIPROCKET_PICKUP_POSTCODE=201304

# Aaysh Express (Air Express)
AAYSH_EXPRESS_EMAIL=Developer@fiberisefit.com
AAYSH_EXPRESS_PASSWORD=fiberisefit123
AAYSH_EXPRESS_BASE_URL=https://aaysh.onrender.com
AAYSH_EXPRESS_PICKUP_LOCATION=Primary
AAYSH_EXPRESS_PICKUP_PINCODE=201304